# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=5000

# Local: mongodb://localhost:27017/ai-leads
# Free cloud: MongoDB Atlas M0 cluster -> mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-leads
MONGODB_URI=mongodb://localhost:27017/ai-leads

# Random string, at least 32 characters (required in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API, comma-separated.
CLIENT_URL=http://localhost:5173

# Set to 1 when deployed behind a proxy (Render, Railway, Heroku...) so rate limits see real client IPs.
TRUST_PROXY=0

# Creates admin@example.com / demo@example.com (password123) on startup. Defaults to true in development only.
# SEED_DEMO_USERS=true

# --- AI (free) --- https://console.groq.com/keys
# Optional: without a key, a rule-based parser and email template are used instead.
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# --- OpenStreetMap (free, no key) ---
# Identify your app per the usage policies; adding a contact URL or email is recommended.
OSM_USER_AGENT=AILeadFinder/1.0 (student project)
# OVERPASS_URLS=https://overpass-api.de/api/interpreter

# --- Optional: send emails from the app ---
# Gmail: enable 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=you@gmail.com
